<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/settings_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/app_logo_description"
                android:src="@drawable/logo_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/close_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_button_background"
                android:contentDescription="@string/close_settings"
                android:focusable="true"
                android:padding="13dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/settings_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/playlist_manager" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/playlist_url_help" />

            <EditText
                android:id="@+id/playlist_url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/search_background"
                android:hint="@string/playlist_url_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/player_engine" />

            <RadioGroup
                android:id="@+id/engine_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/engine_exoplayer"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:text="@string/exoplayer"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/engine_vlc"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:text="@string/native_vlc"
                    android:textColor="@color/text_primary" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/settings_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/aspect_ratio" />

            <RadioGroup
                android:id="@+id/aspect_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/aspect_auto"
                    style="@style/SettingsRadioButton"
                    android:text="@string/auto" />

                <RadioButton
                    android:id="@+id/aspect_16_9"
                    style="@style/SettingsRadioButton"
                    android:text="@string/aspect_16_9" />

                <RadioButton
                    android:id="@+id/aspect_4_3"
                    style="@style/SettingsRadioButton"
                    android:text="@string/aspect_4_3" />

                <RadioButton
                    android:id="@+id/aspect_stretch"
                    style="@style/SettingsRadioButton"
                    android:text="@string/stretch" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/save_settings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/primary_button_background"
            android:focusable="true"
            android:text="@string/save_and_apply"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clear_cache_reload"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/secondary_button_background"
            android:focusable="true"
            android:text="@string/clear_cache_reload"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

</ScrollView>
